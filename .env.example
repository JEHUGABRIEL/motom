# Copiez ce fichier en .env et renseignez vos valeurs
# Variables requises en production (Vercel → Settings → Environment Variables)

# Mot de passe initial du superadmin (utilisé uniquement par le seed)
ADMIN_PASSWORD=change-me

# Secret dédié à la signature des cookies de session (jamais le mot de passe admin,
# générez une chaîne aléatoire longue — ex. `openssl rand -base64 32`)
SESSION_SECRET=change-me-aussi

# Base de données Neon (requise pour lire/écrire les biens et messages)
DATABASE_URL=postgresql://user:password@host/db

# Cloudinary — serveur d'images (upload widget signé côté serveur)
# Le cloud name et la clé API sont publics par conception chez Cloudinary ;
# seul le secret API est confidentiel et reste exclusivement côté serveur.
VITE_CLOUDINARY_CLOUD_NAME=

# Requis par api/cloudinary-sign.ts et les scripts de migration (jamais dans le bundle)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Resend — envoi des emails d'invitation des nouveaux admins
# Clé API : https://resend.com/api-keys (gratuit : 100 emails/jour)
# Tant qu'aucun domaine n'est vérifié, utilisez l'expéditeur test onboarding@resend.dev
# (les emails ne partent alors que vers votre propre adresse).
RESEND_API_KEY=re_xxxxxxxx
RESEND_FROM=MOTOM <onboarding@resend.dev>

# URL publique du back-office (dépôt motom-admin) : origine des liens d'invitation
# et de réinitialisation envoyés par email. Défaut : https://motom-admin.vercel.app
ADMIN_URL=https://motom-admin.vercel.app

# Superadmin (créé au seed) — identité du compte superadmin, jamais en dur dans le code
SUPERADMIN_EMAIL=votre-email@exemple.com
SUPERADMIN_USERNAME=votre-username